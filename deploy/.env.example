# Copy to /opt/pulse/.env on the VM (chmod 600). Never commit the real file.
# Generate secrets on the VM, e.g.: openssl rand -base64 48

SITE_ADDRESS=pulse.koreacentral.cloudapp.azure.com
APP_URL=https://pulse.koreacentral.cloudapp.azure.com

POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-at-least-32-characters

# Email (alerts and password reset). Empty SMTP_HOST = emails are not sent; alerts are retried and logged.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_MAIL_FROM=Pulse <alerts@example.com>

# AI incident summaries. Empty = skipped.
AI_API_KEY=
